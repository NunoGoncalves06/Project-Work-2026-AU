# Copy to .env next to docker-compose.prod.yml on the server and fill in. Never commit .env.

# the hostname pointing at the server's Elastic IP; Caddy gets an HTTPS certificate for it
DOMAIN=au-parking.duckdns.org

# set before the first start: Postgres only reads it while its volume is still empty
POSTGRES_PASSWORD=

# the backend's own database login (parking_app: rows only, no schema changes), set up again on every start,
# so changing it here and restarting changes it. 16+ letters and digits only, e.g. from `openssl rand -hex 24`
APP_DB_PASSWORD=

# admin dashboard login (see docs/deploy-aws.md). Set all four or none; none = admin API refused.
# ADMIN_AUTH=off (no login at all) is for local development only and is never passed by docker-compose.prod.yml
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# host only, without https:// (e.g. au-parking.auth.eu-north-1.amazoncognito.com)
COGNITO_DOMAIN=

# the backend's own broker login; must also be a user in mqtt/config/pwfile
MQTT_USERNAME=parking-backend
MQTT_PASSWORD=

# the login the sensors use to publish; not read by compose, only when creating mqtt/config/pwfile
SENSOR_PASSWORD=
