# Copy to .env next to docker-compose.prod.yml on the server and fill in. Never commit .env.

# the hostname pointing at the server's Elastic IP; Caddy gets an HTTPS certificate for it
DOMAIN=au-parking.duckdns.org

# set before the first start: Postgres only reads it while its volume is still empty
POSTGRES_PASSWORD=

# the backend's own broker login; must also be a user in mqtt/config/pwfile
MQTT_USERNAME=parking-backend
MQTT_PASSWORD=

# the login the sensors use to publish; not read by compose, only when creating mqtt/config/pwfile
SENSOR_PASSWORD=
