# Files copied to the Linux server must keep Linux line endings, even in a Windows checkout:
# a trailing \r would end up in values such as Mosquitto's password_file path.
Caddyfile text eol=lf
docker-compose*.yml text eol=lf
*.conf text eol=lf
.env.example text eol=lf
deploy/*.sh text eol=lf
deploy/*.service text eol=lf
deploy/*.timer text eol=lf
mqtt/config/aclfile text eol=lf
deploy/*.path text eol=lf
